--[[
QwenEdit Fuse for Blackmagic Fusion
Text-guided image understanding and editing using Qwen VL
]]--

FuRegisterClass("QwenEdit", CT_Tool, {
    REGS_Name = "Qwen Edit",
    REGS_Category = "AI Tools",
    REGS_OpIconString = "QWEN",
    REGS_OpDescription = "Text-guided image understanding with Qwen VL",
    REG_NoMotionBlurCtrls = true,
    REG_NoBlendCtrls = true,
})

function Create()
    -- Processing mode
    InMode = self:AddInput("Mode", "Mode", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "Describe", },
        { CCS_AddString = "Answer Question", },
        { CCS_AddString = "Edit Instruction", },
        { CCS_AddString = "Remove Object (Inpaint)", },
    })

    -- Text prompt (optional for removal mode)
    InPrompt = self:AddInput("Prompt", "Prompt", {
        LINKID_DataType = "Text",
        INPID_InputControl = "TextEditControl",
        TEC_Lines = 3,
        INP_Default = "Describe this image in detail",
    })

    -- Inpainting method
    InInpaintMethod = self:AddInput("Inpaint Method", "InpaintMethod", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "LaMa (Fast)", },
        { CCS_AddString = "Stable Diffusion", },
    })

    -- Device selection
    InDevice = self:AddInput("Device", "Device", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "CUDA", },
        { CCS_AddString = "CPU", },
    })

    -- Input image
    InImage = self:AddInput("Input", "Input", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    -- Matte/Mask input for object removal
    InMatte = self:AddInput("Matte", "Matte", {
        LINKID_DataType = "Image",
        LINK_Main = 2,
    })

    -- Output image (edited or pass-through)
    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    -- Text output
    OutText = self:AddOutput("Text", "Text", {
        LINKID_DataType = "Text",
    })
end

function Process(req)
    local img = InImage:GetValue(req)
    if not img then
        return
    end

    -- Get parameters
    local mode_idx = InMode:GetValue(req).Value
    local prompt = InPrompt:GetValue(req).Value or "Describe this image"
    local inpaint_method_idx = InInpaintMethod:GetValue(req).Value
    local device_idx = InDevice:GetValue(req).Value
    local matte = InMatte:GetValue(req)

    -- Map to actual values
    local modes = {"describe", "answer", "edit", "inpaint"}
    local mode = modes[mode_idx + 1] or "describe"

    local inpaint_methods = {"lama", "sd"}
    local inpaint_method = inpaint_methods[inpaint_method_idx + 1] or "lama"

    local devices = {"cuda", "cpu"}
    local device = devices[device_idx + 1] or "cuda"

    -- Get Fusion temp directory
    local comp = self.Comp
    local temp_dir = comp:MapPath("Temp:")

    -- Save input image as EXR to preserve precision and alpha
    local input_path = temp_dir .. "/fusion_ai_qwen_input_" .. req.Time .. ".exr"
    local mask_path = nil
    local output_path = temp_dir .. "/fusion_ai_qwen_output_" .. req.Time .. ".exr"

    img:Save(input_path)

    -- Save matte if in inpaint mode and matte is connected
    if mode == "inpaint" and matte then
        mask_path = temp_dir .. "/fusion_ai_qwen_mask_" .. req.Time .. ".exr"
        matte:Save(mask_path)
    end

    local result_text = ""
    local out_img = img  -- Default to pass-through

    -- Handle different modes
    if mode == "inpaint" and mask_path then
        -- Inpainting mode - remove object
        -- Escape prompt for command line
        local escaped_prompt = prompt:gsub('"', '\\"')

        local python_cmd = string.format(
            'python -c "from fusion_ai.fuses.fusion_bridge import inpaint_process; import json; result = inpaint_process(\'%s\', \'%s\', \'%s\', \'%s\', \'%s\'); print(result)"',
            input_path,
            mask_path,
            output_path,
            inpaint_method,
            escaped_prompt
        )

        -- Execute command and capture output
        local handle = io.popen(python_cmd)
        local json_result = ""
        if handle then
            json_result = handle:read("*a")
            handle:close()
        end

        -- Try to load the output image
        if json_result and json_result ~= "" then
            local success = pcall(function()
                local loaded = Image(output_path)
                if loaded then
                    out_img = loaded
                    result_text = "Object removed successfully"
                end
            end)
        end

        -- Clean up
        if mask_path then os.remove(mask_path) end
        pcall(function() os.remove(output_path) end)

    else
        -- Text-based modes (describe, answer, edit)
        -- Escape prompt for command line
        local escaped_prompt = prompt:gsub('"', '\\"')

        local python_cmd = string.format(
            'python -c "from fusion_ai.fuses.fusion_bridge import qwen_process; import json; result = qwen_process(\'%s\', \'%s\', \'%s\'); print(json.loads(result).get(\'result\', \'\'))"',
            input_path,
            escaped_prompt,
            mode
        )

        -- Execute command and capture output
        local handle = io.popen(python_cmd)
        if handle then
            result_text = handle:read("*a")
            handle:close()
        end
    end

    -- Clean up input temp file
    os.remove(input_path)

    -- Output results
    OutImage:Set(req, out_img)
    OutText:Set(req, Text(result_text or "No result"))

    -- Also print to console
    if result_text and result_text ~= "" then
        print("AI Result: " .. result_text)
    end
end
