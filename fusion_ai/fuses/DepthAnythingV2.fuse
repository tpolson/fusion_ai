--[[
DepthAnythingV2 Fuse for Blackmagic Fusion
Generates depth maps from input images using DepthAnythingV2 model
]]--

FuRegisterClass("DepthAnythingV2", CT_Tool, {
    REGS_Name = "Depth Anything V2",
    REGS_Category = "AI Tools",
    REGS_OpIconString = "DAV2",
    REGS_OpDescription = "Generate depth maps using DepthAnythingV2",
    REG_NoMotionBlurCtrls = true,
    REG_NoBlendCtrls = true,
})

function Create()
    -- Model size selection
    InModelSize = self:AddInput("Model Size", "ModelSize", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Default = 1.0,
        INP_Integer = true,
        { CCS_AddString = "Small", },
        { CCS_AddString = "Base", },
        { CCS_AddString = "Large", },
    })

    -- Precision selection
    InPrecision = self:AddInput("Precision", "Precision", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Default = 1.0,
        INP_Integer = true,
        { CCS_AddString = "FP16", },
        { CCS_AddString = "FP32", },
    })

    -- Output format selection
    InOutputFormat = self:AddInput("Output Format", "OutputFormat", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "Auto (EXR for float)", },
        { CCS_AddString = "EXR", },
        { CCS_AddString = "PNG", },
    })

    -- Normalize output
    InNormalize = self:AddInput("Normalize", "Normalize", {
        LINKID_DataType = "Number",
        INPID_InputControl = "CheckboxControl",
        INP_Default = 1.0,
        INP_Integer = true,
        IC_Visible = true,
    })

    -- Depth Adjustments Section
    self:BeginControlNest("Depth Adjustments", "DepthAdjust", true, {})

    -- Invert depth
    InInvertDepth = self:AddInput("Invert Depth", "InvertDepth", {
        LINKID_DataType = "Number",
        INPID_InputControl = "CheckboxControl",
        INP_Default = 0.0,
        INP_Integer = true,
        IC_Visible = true,
    })

    -- Depth range minimum
    InDepthMin = self:AddInput("Depth Min", "DepthMin", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 0.0,
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        IC_Visible = true,
    })

    -- Depth range maximum
    InDepthMax = self:AddInput("Depth Max", "DepthMax", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 1.0,
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        IC_Visible = true,
    })

    -- Depth contrast
    InDepthContrast = self:AddInput("Contrast", "DepthContrast", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 1.0,
        INP_MinScale = 0.0,
        INP_MaxScale = 3.0,
        IC_Visible = true,
    })

    -- Depth gamma
    InDepthGamma = self:AddInput("Gamma", "DepthGamma", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 1.0,
        INP_MinScale = 0.1,
        INP_MaxScale = 3.0,
        IC_Visible = true,
    })

    -- Temporal smoothing (for sequences)
    InTemporalSmooth = self:AddInput("Temporal Smoothing", "TemporalSmooth", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 0.0,
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        IC_Visible = true,
    })

    self:EndControlNest()

    -- Apply colormap
    InColormap = self:AddInput("Colormap", "Colormap", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "None", },
        { CCS_AddString = "Inferno", },
        { CCS_AddString = "Viridis", },
        { CCS_AddString = "Plasma", },
        { CCS_AddString = "Turbo", },
        IC_Visible = true,
    })

    -- Preserve alpha channel
    InPreserveAlpha = self:AddInput("Preserve Alpha", "PreserveAlpha", {
        LINKID_DataType = "Number",
        INPID_InputControl = "CheckboxControl",
        INP_Default = 1.0,
        INP_Integer = true,
    })

    -- Device selection
    InDevice = self:AddInput("Device", "Device", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "CUDA", },
        { CCS_AddString = "CPU", },
    })

    -- Input image
    InImage = self:AddInput("Input", "Input", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    -- Output depth map
    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    -- Output alpha channel
    OutAlpha = self:AddOutput("Alpha", "Alpha", {
        LINKID_DataType = "Image",
    })
end

function Process(req)
    local img = InImage:GetValue(req)
    if not img then
        return
    end

    -- Get parameters
    local model_size_idx = InModelSize:GetValue(req).Value
    local precision_idx = InPrecision:GetValue(req).Value
    local format_idx = InOutputFormat:GetValue(req).Value
    local normalize = InNormalize:GetValue(req).Value == 1
    local invert_depth = InInvertDepth:GetValue(req).Value == 1
    local depth_min = InDepthMin:GetValue(req).Value
    local depth_max = InDepthMax:GetValue(req).Value
    local depth_contrast = InDepthContrast:GetValue(req).Value
    local depth_gamma = InDepthGamma:GetValue(req).Value
    local temporal_smooth = InTemporalSmooth:GetValue(req).Value
    local colormap_idx = InColormap:GetValue(req).Value
    local preserve_alpha = InPreserveAlpha:GetValue(req).Value == 1
    local device_idx = InDevice:GetValue(req).Value

    -- Map to actual values
    local model_sizes = {"small", "base", "large"}
    local model_size = model_sizes[model_size_idx + 1] or "base"

    local use_fp16 = (precision_idx == 0)  -- 0 = FP16, 1 = FP32

    local output_formats = {"auto", "exr", "png"}
    local output_format = output_formats[format_idx + 1] or "auto"

    local colormaps = {"", "COLORMAP_INFERNO", "COLORMAP_VIRIDIS", "COLORMAP_PLASMA", "COLORMAP_TURBO"}
    local colormap = colormaps[colormap_idx + 1]

    local devices = {"cuda", "cpu"}
    local device = devices[device_idx + 1] or "cuda"

    -- Get Fusion temp directory
    local comp = self.Comp
    local temp_dir = comp:MapPath("Temp:")

    -- Determine file extensions based on format
    local depth_ext = ".exr"
    if colormap ~= "" or output_format == "png" then
        depth_ext = ".png"
    elseif output_format == "auto" then
        depth_ext = ".exr"
    end

    -- Use EXR for input to preserve precision and alpha
    local input_path = temp_dir .. "/fusion_ai_input_" .. req.Time .. ".exr"
    local output_path = temp_dir .. "/fusion_ai_depth_" .. req.Time .. depth_ext
    local alpha_path = temp_dir .. "/fusion_ai_alpha_" .. req.Time .. ".exr"

    -- Save input as EXR to preserve full precision and alpha
    img:Save(input_path)

    -- Build Python command with all parameters including depth adjustments
    local python_cmd = string.format(
        'python -c "from fusion_ai.fuses.fusion_bridge import depth_anything_v2_process; import json; result = depth_anything_v2_process(\'%s\', \'%s\', \'%s\', %s, %s, %s, \'%s\', %s, %s, %f, %f, %f, %f, %f); print(result)"',
        input_path,
        output_path,
        model_size,
        normalize and "True" or "False",
        colormap ~= "" and ("'" .. colormap .. "'") or "None",
        use_fp16 and "True" or "False",
        output_format,
        preserve_alpha and ("'" .. alpha_path .. "'") or "None",
        invert_depth and "True" or "False",
        depth_min,
        depth_max,
        depth_contrast,
        depth_gamma,
        temporal_smooth
    )

    -- Execute command and capture output
    local handle = io.popen(python_cmd)
    local json_result = ""
    if handle then
        json_result = handle:read("*a")
        handle:close()
    end

    -- Load output images
    local out_img = nil
    local out_alpha = nil

    if json_result and json_result ~= "" then
        -- Try to load the generated depth map
        local success = pcall(function()
            local loaded = Image(output_path)
            if loaded then
                out_img = loaded
            end
        end)

        -- Try to load alpha if it was saved
        if preserve_alpha then
            local alpha_success = pcall(function()
                local loaded_alpha = Image(alpha_path)
                if loaded_alpha then
                    out_alpha = loaded_alpha
                end
            end)
        end
    end

    -- Clean up temp files
    os.remove(input_path)
    if out_img then
        os.remove(output_path)
    end
    if out_alpha then
        os.remove(alpha_path)
    end

    -- Set outputs
    OutImage:Set(req, out_img or img)
    if preserve_alpha and out_alpha then
        OutAlpha:Set(req, out_alpha)
    end
end
