--[[
AIUpscale Fuse for Blackmagic Fusion
AI-based image upscaling using Real-ESRGAN and Stable Diffusion
]]--

FuRegisterClass("AIUpscale", CT_Tool, {
    REGS_Name = "AI Upscale",
    REGS_Category = "AI Tools",
    REGS_OpIconString = "UP",
    REGS_OpDescription = "AI-based image super-resolution upscaling",
    REG_NoMotionBlurCtrls = true,
    REG_NoBlendCtrls = true,
})

function Create()
    -- Upscale method
    InMethod = self:AddInput("Method", "Method", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "Real-ESRGAN", },
        { CCS_AddString = "SD Upscaler", },
        IC_Visible = true,
    })

    -- Real-ESRGAN model variant
    InModelVariant = self:AddInput("Model Variant", "ModelVariant", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "RealESRGAN x4 Plus", },
        { CCS_AddString = "RealESRNet x4 Plus", },
        { CCS_AddString = "RealESRGAN x4 Anime", },
        { CCS_AddString = "RealESRGAN x2 Plus", },
        IC_Visible = true,
    })

    -- Scale factor
    InScale = self:AddInput("Scale Factor", "Scale", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 4.0,
        INP_MinScale = 2.0,
        INP_MaxScale = 4.0,
        IC_Visible = true,
    })

    -- Prompt for SD Upscaler
    InPrompt = self:AddInput("Prompt (SD Only)", "Prompt", {
        LINKID_DataType = "Text",
        INPID_InputControl = "TextEditControl",
        TEC_Lines = 2,
        INP_Default = "high quality, detailed",
        IC_Visible = true,
    })

    -- Inference parameters (SD only)
    InInferenceSteps = self:AddInput("Inference Steps (SD)", "InferenceSteps", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 50,
        INP_Integer = true,
        INP_MinScale = 20,
        INP_MaxScale = 100,
        IC_Visible = true,
    })

    InGuidanceScale = self:AddInput("Guidance Scale (SD)", "GuidanceScale", {
        LINKID_DataType = "Number",
        INPID_InputControl = "SliderControl",
        INP_Default = 7.5,
        INP_MinScale = 1.0,
        INP_MaxScale = 20.0,
        IC_Visible = true,
    })

    -- Device selection
    InDevice = self:AddInput("Device", "Device", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ComboControl",
        INP_Default = 0.0,
        INP_Integer = true,
        { CCS_AddString = "CUDA", },
        { CCS_AddString = "CPU", },
        IC_Visible = true,
    })

    -- Input image
    InImage = self:AddInput("Input", "Input", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })

    -- Output upscaled image
    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })
end

function Process(req)
    local img = InImage:GetValue(req)
    if not img then
        return
    end

    -- Get parameters
    local method_idx = InMethod:GetValue(req).Value
    local model_variant_idx = InModelVariant:GetValue(req).Value
    local scale = InScale:GetValue(req).Value
    local prompt = InPrompt:GetValue(req).Value or "high quality, detailed"
    local inference_steps = InInferenceSteps:GetValue(req).Value
    local guidance_scale = InGuidanceScale:GetValue(req).Value
    local device_idx = InDevice:GetValue(req).Value

    -- Map to actual values
    local methods = {"realesrgan", "sd"}
    local method = methods[method_idx + 1] or "realesrgan"

    local model_variants = {
        "RealESRGAN_x4plus",
        "RealESRNet_x4plus",
        "RealESRGAN_x4plus_anime_6B",
        "RealESRGAN_x2plus"
    }
    local model_variant = model_variants[model_variant_idx + 1] or "RealESRGAN_x4plus"

    local devices = {"cuda", "cpu"}
    local device = devices[device_idx + 1] or "cuda"

    -- Get Fusion temp directory
    local comp = self.Comp
    local temp_dir = comp:MapPath("Temp:")

    -- Save input as EXR
    local input_path = temp_dir .. "/fusion_ai_upscale_input_" .. req.Time .. ".exr"
    local output_path = temp_dir .. "/fusion_ai_upscale_output_" .. req.Time .. ".exr"

    img:Save(input_path)

    -- Escape prompt for command line
    local escaped_prompt = prompt:gsub('"', '\\"')

    -- Build Python command
    local python_cmd = string.format(
        'python -c "from fusion_ai.fuses.fusion_bridge import upscale_process; import json; result = upscale_process(\'%s\', \'%s\', \'%s\', \'%s\', %f, \'%s\', %d, %f); print(result)"',
        input_path,
        output_path,
        method,
        model_variant,
        scale,
        escaped_prompt,
        inference_steps,
        guidance_scale
    )

    -- Execute command
    local handle = io.popen(python_cmd)
    local json_result = ""
    if handle then
        json_result = handle:read("*a")
        handle:close()
    end

    -- Load output image
    local out_img = nil
    if json_result and json_result ~= "" then
        local success = pcall(function()
            local loaded = Image(output_path)
            if loaded then
                out_img = loaded
            end
        end)
    end

    -- Clean up temp files
    os.remove(input_path)
    if out_img then
        os.remove(output_path)
    end

    -- Set output
    OutImage:Set(req, out_img or img)
end
